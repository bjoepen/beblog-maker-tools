{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BeBlog Maker Tools",
  "version": "0.2.2",
  "identifier": "de.beblog.makertools",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BeBlog Maker Tools",
        "width": 1260,
        "height": 820,
        "minWidth": 820,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
